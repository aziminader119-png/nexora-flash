# NEXORA v1.0 environment template. NO SECRETS IN THIS FILE.
# Production path: /etc/nexora/nexora.env (root:nexora 0640), created by install-ubuntu.sh.

# --- dashboard / service
PORT=3080
# keep the dashboard local; reach it through an SSH tunnel
BIND_HOST=127.0.0.1
SCAN_INTERVAL_MS=30000
# installer generates: openssl rand -hex 32
ADMIN_TOKEN=REPLACE_WITH_64_HEX_CHARS
DATA_DIR=/var/lib/nexora
GATE_REPORT=/opt/nexora/validation/gate-report.json
RPC_TIMEOUT_MS=9000

# --- loan limits
# Initial maximum flash loan is $1,000 (dashboard setting maxLoanUSD).
# The dashboard can never exceed this server ceiling; the on-chain maxLoan per asset is a third, independent cap.
NEXORA_LOAN_CEILING=10000

# --- RPC endpoints (private endpoints strongly recommended for execution)
# RPC_56=https://...
# RPC_8453=https://...
# RPC_42161=https://...
# RPC_10=https://...
# RPC_137=https://...

# --- deployed executor contracts (from scripts/deploy.mjs)
# EXECUTOR_56=0x...
# EXECUTOR_8453=0x...
# EXECUTOR_42161=0x...
# EXECUTOR_10=0x...
# EXECUTOR_137=0x...

# --- optional Euler V2 vault per chain (stable-asset EVK vault). Never live without a passing fork test.
# EULER_VAULT_8453=0x...

# --- operator signer (contract OPERATOR role only; cannot withdraw or change limits)
# Encrypted keystore; password is delivered by systemd LoadCredential=keystore-password (see install-ubuntu.sh).
# EXECUTOR_KEYSTORE=/var/lib/nexora/keys/operator.json

# --- master switch. Funded execution additionally requires a passing validation gate,
# the network in "liveChains" (dashboard) and "autoExecute" for unattended mode.
LIVE_EXECUTION=false

# --- optional private transaction submission (raw tx goes here instead of the public RPC; https only)
# Recommended on BNB Chain (public mempool). Base/Optimism/Arbitrum sequencers have no public mempool.
# PRIVATE_TX_RPC_56=https://...

# --- Balancer V2 flash loans are OFF by default (Nov 2025 V2 Vault exploit). Opt in only after its fork test passes.
ENABLE_BALANCER_V2=false

# --- passive observation (scripts/observe-market.mjs): operator address used as eth_call sender
# OPERATOR_ADDRESS=0x...
